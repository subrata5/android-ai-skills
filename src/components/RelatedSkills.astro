---
import { getCollection } from 'astro:content';
import SkillCard from './SkillCard.astro';

interface Props {
  relatedSlugs: string[];
}

const { relatedSlugs } = Astro.props;

const allSkills = await getCollection('skills');
const relatedSkills = allSkills.filter((s) => relatedSlugs.includes(s.id));
---

{relatedSkills.length > 0 && (
  <section class="mt-16 pt-8 border-t border-border">
    <div class="mb-6">
      <span class="font-mono text-2xs uppercase tracking-widest text-text-subtle">Catalog Connections</span>
      <h3 class="text-xl font-bold text-text font-sans">Related Engineering Skills</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {relatedSkills.map((skill) => (
        <SkillCard
          slug={skill.id}
          title={skill.data.title}
          description={skill.data.description}
          phase={skill.data.phase}
          command={skill.data.command}
          category={skill.data.category}
          tags={skill.data.tags}
          trigger={skill.data.trigger}
        />
      ))}
    </div>
  </section>
)}
