---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PhaseBadge from '../../components/PhaseBadge.astro';
import TagList from '../../components/TagList.astro';
import TerminalBlock from '../../components/TerminalBlock.astro';
import SkillAnatomy from '../../components/SkillAnatomy.astro';
import RelatedSkills from '../../components/RelatedSkills.astro';
import SkillNavigation from '../../components/SkillNavigation.astro';
import { buildUrl } from '../../utils/url';

export async function getStaticPaths() {
  const skills = await getCollection('skills');
  skills.sort((a, b) => a.data.order - b.data.order);

  return skills.map((skill, index) => {
    const prevSkill = index > 0 ? { slug: skills[index - 1].id, title: skills[index - 1].data.title } : null;
    const nextSkill = index < skills.length - 1 ? { slug: skills[index + 1].id, title: skills[index + 1].data.title } : null;

    return {
      params: { slug: skill.id },
      props: { skill, prevSkill, nextSkill },
    };
  });
}

const { skill, prevSkill, nextSkill } = Astro.props;
const { Content } = await render(skill);

const singleSkillCmd = `npx skills add android-ai-engineering-skills --skill ${skill.id}`;
const allSkillsCmd = `npx skills add android-ai-engineering-skills`;

const catalogUrl = buildUrl('/skills/');
---

<Layout
  title={`${skill.data.title} — Android AI Engineering Skill`}
  description={skill.data.description}
>
  <article class="py-10 border-b border-border bg-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Header / Breadcrumb -->
      <div class="mb-8">
        <nav class="font-mono text-2xs text-text-subtle mb-4" aria-label="Breadcrumb">
          <a href={buildUrl('/')} class="hover:text-text transition-colors">Home</a>
          <span class="mx-2">/</span>
          <a href={catalogUrl} class="hover:text-text transition-colors">Skills</a>
          <span class="mx-2">/</span>
          <span class="text-text font-medium">{skill.data.phase}</span>
        </nav>

        <div class="flex items-center space-x-3 mb-3">
          <PhaseBadge phase={skill.data.phase} size="md" />
          <span class="font-mono text-xs text-text-subtle border border-border px-2 py-0.5 rounded-sm bg-surface">
            {skill.data.command}
          </span>
          <span class="font-mono text-xs text-text-subtle border border-border px-2 py-0.5 rounded-sm bg-surface">
            Category: {skill.data.category}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text font-sans tracking-tight mb-4">
          {skill.data.title}
        </h1>

        <p class="text-base sm:text-lg text-text-muted font-sans max-w-3xl leading-relaxed mb-4">
          {skill.data.description}
        </p>

        <!-- Trigger -->
        <div class="p-3 rounded-sm border border-border bg-surface font-mono text-xs text-text-muted my-4">
          <span class="text-text font-bold uppercase tracking-wider text-2xs block mb-1">WHEN TO USE (TRIGGER):</span>
          <span>"{skill.data.trigger}"</span>
        </div>

        <TagList tags={skill.data.tags} />
      </div>

      <!-- Install Terminal Block -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-8">
        <TerminalBlock label="Install this skill only" command={singleSkillCmd} />
        <TerminalBlock label="Install all 20 skills" command={allSkillsCmd} />
      </div>

      <!-- How This Skill Is Structured -->
      <SkillAnatomy />

      <!-- Main Two-Column Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mt-10">
        
        <!-- Main Content Area -->
        <div class="lg:col-span-8 space-y-8 skill-prose">
          <Content />
        </div>

        <!-- Sticky Sidebar Navigation -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-20 space-y-6">
          <div class="p-5 rounded-sm border border-border bg-surface">
            <h4 class="font-mono text-xs font-bold text-text uppercase tracking-wider mb-4 border-b border-border pb-2">
              On This Page
            </h4>
            <ul class="space-y-2 font-mono text-xs text-text-muted">
              <li>
                <a href="#the-situation" class="hover:text-text transition-colors flex items-center space-x-2">
                  <span class="text-text-subtle">#</span>
                  <span>The Situation</span>
                </a>
              </li>
              <li>
                <a href="#workflow" class="hover:text-text transition-colors flex items-center space-x-2">
                  <span class="text-text-subtle">#</span>
                  <span>Workflow Steps</span>
                </a>
              </li>
              <li>
                <a href="#anti-rationalization-gate" class="hover:text-text transition-colors flex items-center space-x-2">
                  <span class="text-text-subtle">#</span>
                  <span>Anti-Rationalization Gate</span>
                </a>
              </li>
              <li>
                <a href="#red-flags" class="hover:text-text transition-colors flex items-center space-x-2">
                  <span class="text-text-subtle">#</span>
                  <span>Red Flags</span>
                </a>
              </li>
              <li>
                <a href="#verification" class="hover:text-text transition-colors flex items-center space-x-2">
                  <span class="text-text-subtle">#</span>
                  <span>Verification Evidence</span>
                </a>
              </li>
              <li>
                <a href="#exit-criteria" class="hover:text-text transition-colors flex items-center space-x-2">
                  <span class="text-text-subtle">#</span>
                  <span>Exit Criteria</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Skill Metadata Summary Card -->
          <div class="p-5 rounded-sm border border-border bg-surface font-mono text-xs space-y-3">
            <div class="text-2xs text-text-subtle uppercase tracking-wider font-bold">Metadata Summary</div>
            <div class="flex justify-between border-b border-border-subtle pb-1.5">
              <span class="text-text-subtle">Phase:</span>
              <span class="text-text font-bold">{skill.data.phase}</span>
            </div>
            <div class="flex justify-between border-b border-border-subtle pb-1.5">
              <span class="text-text-subtle">Category:</span>
              <span class="text-text">{skill.data.category}</span>
            </div>
            <div class="flex justify-between border-b border-border-subtle pb-1.5">
              <span class="text-text-subtle">Command:</span>
              <span class="text-text">{skill.data.command}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-text-subtle">Order:</span>
              <span class="text-text">#{skill.data.order} of 20</span>
            </div>
          </div>
        </aside>

      </div>

      <!-- Related Skills -->
      <RelatedSkills relatedSlugs={skill.data.related} />

      <!-- Prev / Next Skill Navigation -->
      <SkillNavigation prevSkill={prevSkill} nextSkill={nextSkill} />
    </div>
  </article>
</Layout>

<style is:global>
  /* Dark technical documentation typography for rendered Markdown */
  .skill-prose {
    color: #ededed;
  }

  .skill-prose h1 {
    display: none; /* Already rendered in header */
  }

  .skill-prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: Inter, sans-serif;
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #222222;
    scroll-margin-top: 5rem;
  }

  .skill-prose h3 {
    font-size: 1.125rem;
    font-weight: 700;
    font-family: Inter, sans-serif;
    color: #ededed;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .skill-prose p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #a1a1aa;
    margin-bottom: 1rem;
  }

  .skill-prose ul {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
    color: #a1a1aa;
  }

  .skill-prose ol {
    list-style-type: decimal;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
    color: #a1a1aa;
  }

  .skill-prose li {
    margin-bottom: 0.375rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .skill-prose strong {
    color: #ffffff;
    font-weight: 600;
  }

  .skill-prose code:not(pre code) {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8125rem;
    background-color: #111111;
    color: #ededed;
    padding: 0.15rem 0.35rem;
    border-radius: 2px;
    border: 1px solid #222222;
  }

  .skill-prose pre {
    background-color: #0d0d0d !important;
    border: 1px solid #222222;
    border-radius: 2px;
    padding: 1rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .skill-prose hr {
    border: 0;
    border-top: 1px solid #222222;
    margin: 2rem 0;
  }

  .skill-prose blockquote {
    border-left: 3px solid #444444;
    padding-left: 1rem;
    color: #8a8a8a;
    font-style: italic;
    margin: 1rem 0;
  }
</style>
