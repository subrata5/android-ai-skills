---
import Layout from '../layouts/Layout.astro';
import { buildUrl } from '../utils/url';
---

<Layout title="404 — Skill Not Found">
  <div class="py-24 text-center border-b border-border bg-bg min-h-[60vh] flex items-center justify-center">
    <div class="max-w-md mx-auto px-4">
      <div class="font-mono text-4xl font-extrabold text-text mb-4">404</div>
      <h1 class="text-2xl font-bold text-text font-sans mb-2">Skill Not Found</h1>
      <p class="text-xs text-text-muted font-sans mb-8 leading-relaxed">
        The requested skill slug does not exist in the Android + AI engineering catalog.
      </p>

      <div class="flex items-center justify-center space-x-4 font-mono text-xs">
        <a
          href={buildUrl('/skills/')}
          class="px-5 py-2.5 rounded-sm bg-text text-bg font-medium hover:bg-white transition-colors"
        >
          ← Back to Skills Catalog
        </a>
        <a
          href={buildUrl('/')}
          class="px-5 py-2.5 rounded-sm border border-border bg-surface hover:border-border-hover text-text transition-colors"
        >
          Go Home
        </a>
      </div>
    </div>
  </div>
</Layout>
